    (method pscan (self argv stdin-thunk) (cu-pscan argv stdin-thunk))
    (method pmap (self argv stdin-thunk) (cu-pmap argv stdin-thunk))
    (method watch (self argv stdin-thunk) (cu-watch argv stdin-thunk))
    (method fuser (self argv stdin-thunk) (cu-fuser argv stdin-thunk))
    (method test (self argv stdin-thunk) (cu-test argv stdin-thunk))
    ; the applets' names, as strings, without the class's own method
    (method names (self)
      (map symbol->str (filter (fn (_ s) (not (eq? s (lit names)))) (class-static-methods Applets))))))

; test's other names, [ and [[, are no symbol the reader takes
(Applets def-static! (Str8 ->sym "[") (fn (_ cls argv stdin-thunk) (cu-bracket argv stdin-thunk)))
(Applets def-static! (Str8 ->sym "[[") (fn (_ cls argv stdin-thunk) (cu-dbracket argv stdin-thunk)))

(cu-applets! Applets)

(provide cu/applets Applets)
