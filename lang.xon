; lang.xon -- what this bundle IS.

(lang "coreutils")

; HELIUM, plus exactly the libraries these applets import -- File,
; Sys, Proc, Date, Vector, Random -- and nothing ambient.  Radon is
; only a particular set of libraries to load, and the set it loads
; (the numeric tower, JIT-compiled tokenizer analysers) is the
; difference between a 12-second `ls` and a 3-second one; a tool that
; runs per file in a build cannot afford it (measured 2026-09-02).
; Self-contained like x-make: the tool tier chains no dependencies.
; One bundle, many applets -- the busybox shape:
; `x -l coreutils -- sort -u file`.
(dialect he)

(requires-release "v0.10.0")

(entry "run.x")
